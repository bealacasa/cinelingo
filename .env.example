# Copia este fichero a .env.local y rellena los valores. Nunca subas .env.local al repositorio.
# Ninguna variable usa el prefijo NEXT_PUBLIC_: Supabase solo se usa desde el servidor.

# URL pública de la app (sin barra final). En local: http://localhost:3000
SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave publicable (sb_publishable_...) o anon key heredada. Respeta RLS.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...) o service_role heredada. Se salta RLS: solo en código server-only.
SUPABASE_SECRET_KEY=

# Secreto para firmar (HMAC) las claves de rate limiting. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SECRET=

# Solo desarrollo: IPs de tu red local para abrir `npm run dev` desde el móvil (separadas por comas).
# DEV_ORIGINS=192.168.1.143
